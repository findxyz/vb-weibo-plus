<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="PMD Best Practices"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.github.io/schema/ruleset_2_0_0.xsd">
    <description>Official Best Practices with Spring framework recognition.</description>
    <rule ref="category/java/bestpractices.xml">
        <exclude name="UnitTestContainsTooManyAsserts"/>
    </rule>
    <rule ref="category/java/bestpractices.xml/UnitTestShouldIncludeAssert">
        <properties>
            <property name="extraAssertMethodNames" value="andExpect,andExpectAll,verify,verifyNoInteractions,verifyNoMoreInteractions"/>
        </properties>
    </rule>
</ruleset>
