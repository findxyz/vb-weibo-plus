{
  "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
  "vcs": {
    "enabled": false
  },
  "files": {
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/dist",
      "!!**/test-results",
      "!!**/public",
      "!!**/tests/fixtures",
      "!!**/src/chat/emoji-map.ts",
      "!!**/scripts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noNoninteractiveTabindex": "off",
        "noStaticElementInteractions": "off",
        "useAnchorContent": "off",
        "useAriaPropsSupportedByRole": "off",
        "useKeyWithClickEvents": "off",
        "useMediaCaption": "off",
        "useSemanticElements": "off"
      },
      "correctness": {
        "noInvalidDirectionInLinearGradient": "off",
        "useExhaustiveDependencies": "warn"
      }
    }
  },
  "assist": {
    "enabled": false
  }
}
