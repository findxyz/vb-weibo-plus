{
  "name": "vb-weibo-plus-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "format": "biome format --write .",
    "lint": "biome check . && node scripts/check-boundaries.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run lint && npm run typecheck && vite build",
    "test": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.2",
    "@ui-sdk/core": "^0.1.0-beta.17",
    "@ui-sdk/react": "^0.1.0-beta.17",
    "dompurify": "3.4.17",
    "lucide-react": "^1.83.0",
    "marked": "^18.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
